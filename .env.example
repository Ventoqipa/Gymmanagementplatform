# API de seguridad Tanosi
VITE_SECURITY_API_URL=https://apisecuritygetest.tanosi.com.mx
VITE_APP_ID=5
VITE_TYPE_ACCESS=W

# POS — API REST (Neubox). Producción: subdominio en tu cuenta Neubox.
# Ejemplo: https://pos.elitegym247.tanosi.com.mx/api/v1/products
VITE_POS_API_BASE_URL=https://pos.elitegym247.tanosi.com.mx
VITE_POS_API_PREFIX=/api/v1
VITE_POS_TENANT_ID=elite-gym
VITE_POS_BRANCH_ID=1
# true = solo memoria (sin llamadas HTTP)
VITE_POS_USE_MOCK=false
