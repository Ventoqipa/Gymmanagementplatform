# ─── Desarrollo (npm run dev) ───────────────────────────────────────────────
# Deja VITE_SECURITY_API_URL y VITE_POS_API_BASE_URL vacías → proxy Vite.

# VITE_SECURITY_API_URL=
# VITE_POS_API_BASE_URL=
# VITE_SECURITY_API_PROXY_TARGET=https://apisecurityegtest.tanosi.com.mx
# VITE_CATALOG_API_PROXY_TARGET=https://apicatalogsegtest.tanosi.com.mx
# VITE_CATALOG_API_URL=/catalog-api
# VITE_POS_API_PROXY_TARGET=https://elitegym247.pos.tanosi.com.mx

VITE_APP_ID=5
VITE_TYPE_ACCESS=W

# Catálogo Client — país / estado / municipio al dar de alta miembros
VITE_CATALOG_DEFAULT_COUNTRY_ID=117
VITE_CATALOG_DEFAULT_STATE_ID=25
VITE_CATALOG_DEFAULT_MUNICIPALITY_ID=23
VITE_CATALOG_DEFAULT_STATUS_ID=1
# ─── Producción Neubox (npm run build) ──────────────────────────────────────

# VITE_SECURITY_API_URL=https://apisecurityegtest.tanosi.com.mx
# VITE_POS_API_BASE_URL=https://elitegym247.pos.tanosi.com.mx

# ─── POS (Tienda) ───────────────────────────────────────────────────────────
# rest   = productos/ventas vía /pos-api → elitegym247.pos.tanosi.com.mx
# local  = solo localStorage (pruebas / demo)
# hybrid = REST con fallback a localStorage si falla red o 5xx

VITE_POS_DATA_SOURCE=rest
VITE_POS_USE_MOCK=false
VITE_POS_API_BASE_URL=/pos-api
VITE_POS_API_KEY=pos-dev-elitegym-temp-2026

VITE_POS_TENANT_ID=elite-gym
VITE_POS_BRANCH_ID=1
